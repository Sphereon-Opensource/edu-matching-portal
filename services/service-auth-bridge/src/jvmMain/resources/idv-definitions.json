  "useCases": [
    {
      "id": { "value": "kw1c-wallet-login" },
      "tenantId": "default",
      "name": "KW1C Wallet Login",
      "description": "Identity verification for KW1C wallet-based student login. Presents a wallet credential, then reconciles identity via SURFconext OIDC if the holder key is unknown.",
      "enabled": true,
      "target": {
        "associationType": "NATURAL_PERSON",
        "allowExistingIdentity": true,
        "autoCreateParty": true
      },
      "triggers": [
        {
          "entryPointType": { "value": "wallet_oid4vp" },
          "triggerType": { "value": "onboarding" }
        },
        {
          "entryPointType": { "value": "wallet_oid4vp" },
          "triggerType": { "value": "registration" }
        }
      ],
      "graph": {
        "_type": "com.sphereon.identity.idv.model.SequenceNode",
        "nodeId": { "value": "root" },
        "children": [
          {
            "_type": "com.sphereon.identity.idv.model.MethodNode",
            "nodeId": { "value": "surf-oidc-node" },
            "methodId": { "value": "surf-oidc" }
          }
        ]
      },
      "policy": {
        "minimumAssurance": "substantial",
        "minimumAal": "aal2",
        "sessionTtlSeconds": 600,
        "allowPartialCompletion": false
      },
      "materializations": [
        {
          "_type": "com.sphereon.identity.idv.model.CreateIdentityMatchMaterialization",
          "hashAlgorithm": "HS256"
        },
        {
          "_type": "com.sphereon.identity.idv.model.CreateIdentifiersMaterialization",
          "identifierFilter": [
            "email",
            "federated_subject"
          ]
        },
        {
          "_type": "com.sphereon.identity.idv.model.MarkVerifiedMaterialization"
        }
      ],
      "userMessage": "Please verify your identity via your institution to complete registration.",
      "completionMessage": "Identity verified successfully. Your wallet is now linked to your institutional account."
    }
