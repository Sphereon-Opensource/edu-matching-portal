# ============================================================================
# Portal E2E / Integration Test Environment
# ============================================================================
# Copy to .env or pass via --env-file when running docker-compose.test.yml

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=test-password

# ── Keycloak Admin ──────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=admin

# ── SURF Federation (simulated by keycloak-surf) ───────────────────────────
SURF_ISSUER_URL=http://keycloak:8080/realms/portal
SURF_CLIENT_ID=portal
SURF_CLIENT_SECRET=dev-client-secret

# ── STS ─────────────────────────────────────────────────────────────────────
STS_CLIENT_SECRET=dev-client-secret
STS_ISSUER_URL=http://localhost:8080

# ── Auth Bridge HMAC Keys ──────────────────────────────────────────────────
HMAC_KEY_A=test-hmac-key-a-for-e2e-testing
HMAC_KEY_B=test-hmac-key-b-for-e2e-testing

# ── Auth Bridge Reconciliation ─────────────────────────────────────────────
RECONCILIATION_ISSUER_URL=http://keycloak:8080/realms/portal
RECONCILIATION_CLIENT_ID=portal-reconciliation
RECONCILIATION_CLIENT_SECRET=dev-secret

# ── Next.js / next-auth (portal app on host) ───────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=test-nextauth-secret-for-e2e-testing

# ── Service Endpoints (as seen from the host) ──────────────────────────────
# These are used by host-side test runners (Playwright, integration tests)
STS_BASE_URL=http://localhost:8080
AUTH_BRIDGE_BASE_URL=http://localhost:8090
KEYCLOAK_BASE_URL=http://localhost:8083
KEYCLOAK_SURF_BASE_URL=http://localhost:8084

# ── Keycloak Test Users ─────────────────────────────────────────────────────
# Portal realm (acting as institution IdP)
TEST_USER_EMAIL=test@kw1c.nl
TEST_USER_PASSWORD=password
TEST_STAFF_EMAIL=staff@kw1c.nl
TEST_STAFF_PASSWORD=password

# SURF realm (acting as SURFconext federation)
TEST_SURF_STUDENT_EMAIL=student1@kw1c.nl
TEST_SURF_STUDENT_PASSWORD=password
TEST_SURF_STAFF_EMAIL=staff1@kw1c.nl
TEST_SURF_STAFF_PASSWORD=password
