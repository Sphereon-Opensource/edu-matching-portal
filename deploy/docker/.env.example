# PostgreSQL
POSTGRES_PASSWORD=dev-password

# SURF Federation (SURFconext test environment)
SURF_CLIENT_ID=kw1c-surf.demo.sphereon.com
SURF_CLIENT_SECRET=

# Reconciliation OIDC (same SURFconext client)
IDENTITY_RECONCILIATION_PROVIDERS_SURF_CLIENT_ID=kw1c-surf.demo.sphereon.com
IDENTITY_RECONCILIATION_PROVIDERS_SURF_CLIENT_SECRET=

# STS
STS_ISSUER_URL=http://localhost:8092
STS_BASE_URL=http://localhost:8092
STS_CLIENT_ID=portal
STS_CLIENT_SECRET=dev-client-secret

# Keycloak (local IdP federation)
KEYCLOAK_ENABLED=true
KEYCLOAK_ISSUER_URL=http://keycloak:8080/realms/portal
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_AUTHORIZATION_ENDPOINT_OVERRIDE=http://localhost:8083/realms/portal/protocol/openid-connect/auth
KEYCLOAK_TOKEN_ENDPOINT_OVERRIDE=http://keycloak:8080/realms/portal/protocol/openid-connect/token
KEYCLOAK_USERINFO_ENDPOINT_OVERRIDE=http://keycloak:8080/realms/portal/protocol/openid-connect/userinfo

# External API (JWT validation)
EXTERNAL_API_JWT_JWKS_URI=http://keycloak:8080/realms/portal/protocol/openid-connect/certs

# Security (set to false in production behind TLS)
OAUTH2_CLIENT_ALLOW_INSECURE_HTTP=true

# Auth Bridge HMAC Keys (domain-separated)
HMAC_KEY_A=dev-hmac-key-a-change-in-production
HMAC_KEY_B=dev-hmac-key-b-change-in-production

# Next.js / next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-here
AUTH_TRUST_HOST=true

# Branding (optional)
#APP_NAME=KW1C Portal
#PRIMARY_COLOR=#0085CA
#SECONDARY_COLOR=#EF2B2D
#LOGO_URL=/branding/kw1c-logo.svg
#LOGO_DARK_URL=/branding/kw1c-logo-dark.svg
