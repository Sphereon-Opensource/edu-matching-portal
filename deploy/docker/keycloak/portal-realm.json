{
  "realm": "portal",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "student",
        "description": "Student role for portal users"
      },
      {
        "name": "staff",
        "description": "Staff role for portal users"
      }
    ]
  },
  "clients": [
    {
      "clientId": "portal",
      "name": "Portal",
      "description": "Portal application client (auth code + PKCE)",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-client-secret",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*",
        "http://localhost:8085/*",
        "http://service-sts:8080/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8080",
        "http://localhost:8085",
        "http://service-sts:8080"
      ],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "surf-claims"
      ]
    },
    {
      "clientId": "portal-reconciliation",
      "name": "Portal Reconciliation",
      "description": "Client used by auth-bridge for identity reconciliation via OIDC",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8090/*",
        "http://service-auth-bridge:8090/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8090",
        "http://service-auth-bridge:8090"
      ],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "surf-claims"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "openid",
      "description": "OpenID Connect scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      }
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "given_name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "family_name",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "email_verified",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "name": "surf-claims",
      "description": "Custom scope that exposes SURF federation claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "eduid-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "eduid",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "eduid",
            "jsonType.label": "String"
          }
        },
        {
          "name": "schac-home-org-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "schac_home_organization",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "schac_home_organization",
            "jsonType.label": "String"
          }
        },
        {
          "name": "eduperson-affiliation-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "eduperson_affiliation",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "eduperson_affiliation",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "openid",
    "profile",
    "email",
    "surf-claims"
  ],
  "users": [
    {
      "username": "test@kw1c.nl",
      "enabled": true,
      "email": "test@kw1c.nl",
      "emailVerified": true,
      "firstName": "Jan",
      "lastName": "de Vries",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "attributes": {
        "eduid": ["urn:mace:eduid.nl:1.0:d57b4:test-student-001"],
        "schac_home_organization": ["kw1c.nl"],
        "eduperson_affiliation": ["student"]
      },
      "realmRoles": ["student"]
    },
    {
      "username": "staff@kw1c.nl",
      "enabled": true,
      "email": "staff@kw1c.nl",
      "emailVerified": true,
      "firstName": "Marie",
      "lastName": "Jansen",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "attributes": {
        "eduid": ["urn:mace:eduid.nl:1.0:d57b4:test-staff-001"],
        "schac_home_organization": ["kw1c.nl"],
        "eduperson_affiliation": ["staff"]
      },
      "realmRoles": ["staff"]
    },
    {
      "username": "testuser",
      "enabled": true,
      "email": "test@example.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "surf-federation",
      "displayName": "SURF Federation (simulated)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "portal-federation-client",
        "clientSecret": "dev-federation-secret",
        "tokenUrl": "http://keycloak-surf:8080/realms/surf/protocol/openid-connect/token",
        "authorizationUrl": "http://localhost:8084/realms/surf/protocol/openid-connect/auth",
        "logoutUrl": "http://keycloak-surf:8080/realms/surf/protocol/openid-connect/logout",
        "userInfoUrl": "http://keycloak-surf:8080/realms/surf/protocol/openid-connect/userinfo",
        "issuer": "http://localhost:8084/realms/surf",
        "defaultScope": "openid profile email",
        "validateSignature": "false",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "eduid-mapper",
      "identityProviderAlias": "surf-federation",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "eduid",
        "user.attribute": "eduid",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "schac-home-org-mapper",
      "identityProviderAlias": "surf-federation",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "schac_home_organization",
        "user.attribute": "schac_home_organization",
        "syncMode": "FORCE"
      }
    }
  ]
}
